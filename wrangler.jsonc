{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testshop",
  "main": "./src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testshop-db",
      "database_id": "REPLACE_ME"
    }
  ]
}
